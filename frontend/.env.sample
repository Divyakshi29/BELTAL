# ==============================================================================
# TRUSTCHAIN FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend REST API endpoint (consumed by React/Vite client)
VITE_API_URL=http://localhost:4000/api

# Blockchain RPC Provider & Smart Contracts
# Ethereum Sepolia: https://ethereum-sepolia-rpc.publicnode.com (or an Infura/Alchemy Sepolia endpoint)
# Local Hardhat/Anvil: http://127.0.0.1:8545
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CONTRACT_ADDRESS=

# IPFS Gateway URL for rendering pinned documents/images in the browser
# Public Pinata Gateway: https://gateway.pinata.cloud/ipfs
# Public IPFS: https://ipfs.io/ipfs
# Dedicated Pinata Gateway: https://<your-subdomain>.mypinata.cloud/ipfs
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
