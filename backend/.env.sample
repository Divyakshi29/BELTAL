# ==============================================================================
# TRUSTCHAIN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Run "npm run deploy:sepolia" in blockchain/ to get the contract addresses.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS Origin for Frontend Client
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL Read-Cache / Prisma ORM)
# Local: postgresql://postgres:postgres@localhost:5432/beltal?schema=public
# Cloud (Neon/Supabase): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beltal?schema=public"

# Blockchain Provider (Ethereum Sepolia Testnet / Local Node)
# Local Hardhat/Anvil: http://127.0.0.1:8545
# Ethereum Sepolia: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Smart Contract Addresses — filled automatically by blockchain/scripts/deploy.js
# Run: cd blockchain && npm run deploy:sepolia
CONTRACT_ADDRESS=
AUDIT_LOG_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
ACCESS_CONTROL_ADDRESS=
ASSET_NFT_ADDRESS=

# Block at which the latest deployment started — used by the indexer for backfill.
# Set this to the "deploymentBlock" value from blockchain/deployments/sepolia.json
# after every redeploy.
INDEXER_FROM_BLOCK=

# Deployer / Admin Wallet Private Key (hex, with or without 0x prefix)
DEPLOYER_PRIVATE_KEY=

# Dedicated key for the ROLE_SYSTEM_CONNECTOR machine identity (PACS/HRMS
# automated ingest, issue #74) — kept separate from DEPLOYER_PRIVATE_KEY so
# machine-submitted transactions are attributable to the machine identity,
# not the human admin service key. Falls back to DEPLOYER_PRIVATE_KEY (with
# a warning logged) if left unset.
SYSTEM_CONNECTOR_PRIVATE_KEY=

# On-chain event indexer (backfills events missed while the server was down, then keeps polling).
# INDEXER_FROM_BLOCK: block the contracts were deployed at — the first run scans from here.
#   Unset = scan only the last INDEXER_LOOKBACK_BLOCKS blocks (a warning is logged).
# INDEXER_CHUNK_SIZE: blocks per eth_getLogs call; auto-halves if the RPC rejects the range
#   (free Alchemy/Infura tiers allow far fewer blocks than public nodes).
# INDEXER_CONFIRMATIONS: blocks to wait before indexing, as a guard against shallow reorgs.
INDEXER_FROM_BLOCK=
INDEXER_LOOKBACK_BLOCKS=50000
INDEXER_CHUNK_SIZE=2000
INDEXER_POLL_INTERVAL_MS=10000
INDEXER_CONFIRMATIONS=1

# JWT Authentication
# The default below is for local dev only — startup fails if NODE_ENV=production and it is unchanged.
JWT_SECRET=trustchain-dev-secret-key-32chars-min-len
# Token lifetime (default 1h). Tokens are not re-checked against the database, so a
# role change or revocation only takes effect once the token expires.
JWT_EXPIRES_IN=1h

# Bootstrap admins: comma-separated wallet addresses. A listed wallet that has no
# identity yet is auto-approved as ADMIN (highest clearance) the moment it submits
# its name + employee ID via the registration form. Every other wallet needs an
# ADMIN's approval. Leave empty to disable bootstrapping. Example:
# ADMIN_WALLETS=0xAbc...,0xDef...
ADMIN_WALLETS=

# PII Dossier Encryption (AES-256-GCM, 32-byte key as 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random dev-only key is generated per process start (won't survive a restart).
DOSSIER_ENCRYPTION_KEY=

# Decentralized Storage (Pinata / IPFS for Encrypted Dossiers & Asset Specs)
# Modern Pinata uses the JWT (Secret Access Token). You can also set Key & Secret.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
# Optional. Pins every BELTAL upload (identity dossiers and asset specs) into
# one dedicated Pinata group so they stay separable from anything else on the
# same account. Create the group in the Pinata dashboard and paste its id.
PINATA_GROUP_ID=

# AI Query Assistant (optional — issues #49/#50)
# Anthropic API key for the natural-language audit assistant at
# POST /api/assistant/query. Leave blank to disable: the endpoint then reports
# itself unconfigured and the auditor UI hides the panel. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Anti-Tamper Lab demo tools (Simulate insider tamper / Restore from chain).
# They edit the Postgres cache only, never the chain. Default: on outside
# production, off in production. Set true/false to override.
# ENABLE_TAMPER_SIMULATION=true

# Guardian-based account recovery (issue #51)
# How many guardians must vouch for a recovery before an admin may execute the
# on-chain re-link. Capped at the number of guardians the identity actually
# has, so a 2 here with 1 guardian assigned still needs only that 1.
RECOVERY_APPROVAL_THRESHOLD=2
